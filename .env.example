# Jamot environment (copy to .env and fill in)

# --- Database ---
DATABASE_URL=postgres://jamot:jamot@localhost:5433/jamot
REDIS_URL=redis://localhost:6379

# --- Temporal knowledge graph (Graphiti MCP server + FalkorDB) ---
# Enables a dual-write mirror of memories into Graphiti; Postgres remains the
# source of truth for reads. Requires the graphiti-mcp service in docker-compose
# and an LLM API key (OPENAI_API_KEY above / below).
GRAPHITI_ENABLED=false
GRAPHITI_MCP_URL=http://localhost:8000/mcp/
GRAPHITI_GROUP_ID=main
GRAPHITI_TELEMETRY_ENABLED=false
# LLM concurrency for episode extraction (OpenAI Tier 2 ~5-8; keep low to bound cost)
SEMAPHORE_LIMIT=2

# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_COOKIE_NAME=jamot_session

# --- Google OAuth (sign-in with Google) ---
# Production values should use the actual domains:
#   GOOGLE_REDIRECT_URI=https://api.jamot.pro/api/auth/google/callback
#   GOOGLE_CONNECTOR_REDIRECT_URI=https://api.jamot.pro/api/google/callback
#   FRONTEND_URL=https://mvp.jamot.pro
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Google connector redirect (People API + Gmail sync). Must be registered in the
# Google Cloud Console under Authorized redirect URIs for the same OAuth client.
GOOGLE_CONNECTOR_REDIRECT_URI=http://localhost:4000/api/google/callback
FRONTEND_URL=http://localhost:3000

# --- Connectors (Composio) ---
# Global default API key (backend.composio.dev). Can be overridden per-org in
# Vault under `composio/api-key/<orgId>`.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_REDIRECT_URI=http://localhost:4000/api/composio/callback

# --- Super Admin ---
# Comma-separated emails that are granted full platform super-admin access at boot (grant-only).
SUPER_ADMIN_EMAILS=

# --- LLM providers (both behind a provider interface) ---
LLM_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Channels ---
# Matrix (self-hosted Synapse)
MATRIX_HOMESERVER_URL=http://localhost:8008
MATRIX_BOT_USER=
MATRIX_BOT_PASSWORD=
# Telegram bot (long-polling) — bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional custom Bot API base URL
TELEGRAM_API_URL=
# WhatsApp (Baileys) — session dir for persistent state
WHATSAPP_SESSION_DIR=./.data/whatsapp
# Where the API proxies the WhatsApp control server (channel worker)
# Local: http://localhost:3001 — Render: http://jamot-channels:10000
WA_WORKER_URL=http://localhost:3001
# Control server port for the channel worker (default: 3001; Render uses $PORT)
WA_CONTROL_PORT=3001

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Directory for self-hosted org logo uploads (served from /uploads/*).
# Local default: ./uploads  — Render: /data/uploads (on the wa-session disk)
UPLOADS_DIR=./uploads

# --- Web (apps/web) ---
# Public API base URL. On Render this should be the API's public host.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Root domain used to detect per-org subdomains (e.g. org.jamot.pro). Leave
# empty/blank to disable subdomain auto-activation.
NEXT_PUBLIC_ROOT_DOMAIN=
# Google Maps JS API key for the Lead generation map area picker (browser-side,
# restrict by HTTP referrer). Requires Google billing + Maps JS + Geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Lead generation & enrichment ---
# Apollo.io API key (people search + enrichment). Can also be stored per-org in
# Vault under `leads/apollo/<orgId>`.
APOLLO_API_KEY=
# Cap on the number of leads collected per Lead List run.
LEAD_MAX_PER_RUN=100