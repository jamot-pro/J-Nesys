{
  "name": "jamot",
  "version": "0.1.0",
  "private": true,
  "description": "Jamot — universal organizational kernel",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev:api": "pnpm --filter @jamot/api dev",
    "dev:web": "pnpm --filter @jamot/web dev"
  }
}
