{
  "name": "@jamot/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared browser API client for every Jamot web surface (cockpit, per-org consoles). Transport only \u2014 no React, no app state.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./branding": "./src/branding.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint configured\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.21.0"
}
